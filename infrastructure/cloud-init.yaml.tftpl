#cloud-config
# Startup script for the amackerel prod droplet.
# - installs Docker, Docker Compose + cloudflared
# - saves the existing docker compose.yaml to the vm
# - runs docker compose up to run the application locally at localhost:8080
# - installs the Cloudflare tunnel as a service (ingress hostname -> http://localhost:8080
#   is configured dashboard-side on the named tunnel)

package_update: true
package_upgrade: true

write_files:
  # write docker compose file
  - path: /opt/amackerel/compose.yaml
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, COMPOSE_CONTENT)}

  # write .env 
  - path: /opt/amackerel/.env
    owner: root:root
    permissions: "0644"
    content: |
      APP_IMAGE=${APP_IMAGE}
      GITHUB_API_TOKEN=${GITHUB_API_TOKEN}

  # systemd unit that runs docker compose.
  - path: /etc/systemd/system/app.service
    permissions: "0644"
    content: |
      [Unit]
      Description=amackerel docker compose 
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      RestartSec=5
      TimeoutStartSec=300
      WorkingDirectory=/opt/amackerel
      ExecStartPre=/usr/bin/mkdir -p /var/log/amackerel
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down

      [Install]
      WantedBy=multi-user.target

  # systemd unit that cleans up old log files from /var/log/amackerel (the host
  # side of the container's XDG_STATE_HOME mount) if they are older than 30 days
  - path: /etc/systemd/system/cleaner-upper.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Clean up log files older than 30 days from /var/log/amackerel
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/find /var/log/amackerel -type f -name "app.log.*" -mtime +30 -delete

      [Install]
      WantedBy=multi-user.target

  # timer that triggers cleaner-upper.service daily
  - path: /etc/systemd/system/cleaner-upper.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Run cleaner-upper.service daily

      [Timer]
      OnCalendar=daily
      Persistent=true
      RandomizedDelaySec=15m

      [Install]
      WantedBy=timers.target

runcmd:
  # Docker
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list

  # cloudflared
  - mkdir -p --mode=0755 /usr/share/keyrings
  - curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
  - echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list

  # installs
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli docker-compose-plugin containerd.io cloudflared

  # run the application
  - systemctl daemon-reload
  - systemctl enable --now app.service
  - systemctl enable --now cleaner-upper.timer

  # Cloudflare tunnel (edge 443 -> http://localhost:8080 via dashboard ingress)
  - cloudflared service install ${CF_TUNNEL_TOKEN}
